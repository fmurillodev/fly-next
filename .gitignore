# Local AI runtime state (skill registry, harness caches)
.atl/
.pi/
.gentle/
.claude/
.engram/

# Environment files and credentials (a documented example file is allowed)
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.railway/

# Dependencies and build output
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Logs and OS/editor noise
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Challenge source material must never be published
*.pdf

# Local project-level skill install (Archify); regenerable, not part of the product
.agents/
skills-lock.json
