    {
      "dot": "cyan",
      "title": "Incertidumbre",
      "items": [
        "Fuente degradada no fundamenta una decisión definitiva",
        "Sin Minimum Connection Time inventado: margen positivo sin evidencia es UNKNOWN"
      ]
    },
    {
      "dot": "emerald",
      "title": "Conexión",
      "items": [
        "Margen 0 o negativo, o evidencia operacional: AT_RISK",
        "MISSED solo con confirmación, nunca con una estimación"
      ]
    },
    {
      "dot": "rose",
      "title": "Acciones",
      "items": [
        "Solo recomienda; no ejecuta ninguna acción",
